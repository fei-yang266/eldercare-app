<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_trend_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/divider"/>

        <!-- 心率图表 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_heart_rate_title"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/heart_rate_agg_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_heart_rate_agg_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"/>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/heart_rate_chart"
            android:layout_width="match_parent"
            android:layout_height="120dp"/>

        <!-- 血氧图表 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/chart_blood_oxygen_title"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/blood_oxygen_agg_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_blood_oxygen_agg_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"/>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/blood_oxygen_chart"
            android:layout_width="match_parent"
            android:layout_height="120dp"/>

        <!-- 步数图表 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/chart_steps_title"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/steps_agg_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_steps_agg_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"/>

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/steps_chart"
            android:layout_width="match_parent"
            android:layout_height="120dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
